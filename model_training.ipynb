================================================================================================
Cell 1: Goal
================================================================================================
# Gene2Care AI - Model Training (Competition Version)

"""
Goal:
- Predict treatment suitability (regression)
- Predict early non-response risk (classification)

Key idea:
- Multi-output ML + clinical features
- Designed for explainable decision support
"""
===============================================================================================
Cell 2 — Import
===============================================================================================
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OrdinalEncoder

from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor
from sklearn.multioutput import MultiOutputRegressor

from sklearn.metrics import classification_report, mean_squared_error

import joblib
================================================================================================
Cell 3: Load data
================================================================================================
df = pd.read_csv("../data/synthetic_data.csv")

print("Shape:", df.shape)
df.head()
================================================================================================
Cell 4: Features
================================================================================================
NUMERIC_FEATURES = [
    "age", "phq9", "gad7", "sleep_quality",
    "symptom_duration_months", "recurrence_count"
]

CATEGORICAL_FEATURES = [
    "gender", "prior_treatment_status",
    "functional_impairment", "therapy_access"
]

TARGET_REG = [
    "medication_first_suitability",
    "psychotherapy_first_suitability",
    "combined_care_suitability"
]

TARGET_CLF = "non_response_risk"
================================================================================================
Cell 5: Preprocessing
================================================================================================
numeric = Pipeline([
    ("imputer", SimpleImputer(strategy="median"))
])

categorical = Pipeline([
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("encoder", OrdinalEncoder(handle_unknown="use_encoded_value", unknown_value=-1))
])

preprocessor = ColumnTransformer([
    ("num", numeric, NUMERIC_FEATURES),
    ("cat", categorical, CATEGORICAL_FEATURES)
])
================================================================================================
Cell 6: Split data
================================================================================================
X = df[NUMERIC_FEATURES + CATEGORICAL_FEATURES]
y_reg = df[TARGET_REG]
y_clf = df[TARGET_CLF]

X_train, X_test, y_reg_train, y_reg_test = train_test_split(X, y_reg, test_size=0.2, random_state=42)
_, _, y_clf_train, y_clf_test = train_test_split(X, y_clf, test_size=0.2, random_state=42)
================================================================================================
Cell 7: Train model
================================================================================================
rf_clf = Pipeline([
    ("prep", preprocessor),
    ("model", RandomForestClassifier(max_depth=5, random_state=42))
])

rf_reg = Pipeline([
    ("prep", preprocessor),
    ("model", MultiOutputRegressor(RandomForestRegressor(max_depth=8, random_state=42)))
])

rf_clf.fit(X_train, y_clf_train)
rf_reg.fit(X_train, y_reg_train)
================================================================================================
Cell 8: Evaluate
================================================================================================
# Classification
y_pred = rf_clf.predict(X_test)
print("Classification Report:\n")
print(classification_report(y_clf_test, y_pred))

# Regression
y_pred_reg = rf_reg.predict(X_test)
mse = mean_squared_error(y_reg_test, y_pred_reg)

print("\nRegression MSE:", mse)
================================================================================================
Cell 9: Save model
================================================================================================
models = {
    "rf_clf": rf_clf,
    "rf_reg": rf_reg,
    "classes": rf_clf.named_steps["model"].classes_,
    "target_reg": TARGET_REG,
    "target_clf": TARGET_CLF
}

joblib.dump(models, "../models/gene2care_models.joblib")

print("Model saved!")
================================================================================================
Cell 10: Demo prediction
================================================================================================
sample = X_test.iloc[[0]]

print("Input:")
print(sample)

print("\nPredicted risk:", rf_clf.predict(sample))
print("Treatment scores:", rf_reg.predict(sample))
